# Remote execution settings (the keys are fixed, so a file written for an earlier deployment loads as it is;
# dm.permissions_timeout_seconds, dm.cleanup_workflow, targets.crux.listing and
# targets.crux.status_failure_budget_seconds are optional). Copy outside the checkout and replace the
# example values before enabling. These are literal examples; YAML does not expand environment variables. The
# portal names this file in its TOML settings ([remote] enabled, settings_file); the launcher on the DM host reads
# its own copy (dm.launcher_config), whose dm.setup_file the permissions stage uses.
# Unknown keys, and values the code could not use, are refused (laueportal.remote.settings); values are kept as
# written. docs/runbooks/remote-execution.md has the details.
enabled: false  # the portal's [remote] enabled decides; this value is ignored
# Run directories live under <experiment>/analysis/; it must be the portal's files.runs_root.
experiment_directory: /path/to/experiment
poll_seconds: 10
submission_directory: /path/to/experiment/analysis/submissions
state_directory: /path/to/launcher/state/bdp

auth_profile: personal
# Used only for the beamline profile. Reference the existing file; never copy it.
credentials_file: /path/to/existing/credentials.sh

dm:
  # null on the API host; otherwise user@api-bridge.example.invalid.
  ssh_host: null
  setup_file: /path/to/dm/setup.sh
  owner: WORKFLOW_OWNER
  user_account: null  # Defaults to owner.
  workflow: laue-portal-bdp
  cancel_workflow: laue-portal-bdp-cancel
  # The DM workflow of the launcher's cleanup stage (a published run's Eagle folder and state file, then the
  # inbox copy). Set it once the launcher runs this portal's stage and the workflow is registered; null: not cleaned.
  cleanup_workflow: null
  timeout_seconds: 30
  permissions_timeout_seconds: 300  # Recursive storage-service metadata updates.
  # Local launcher settings on the workflow host. SSH is an optional fallback.
  launcher_ssh_host: null
  launcher_python: /path/to/launcher/envs/laue-portal/bin/python
  launcher_code: /path/to/launcher/src  # the launcher's checkout (deploy/remote/dm-stage.sh is in it)
  launcher_config: /path/to/launcher/config/bdp.yaml

storage:
  aps:
    collection_id: 00000000-0000-0000-0000-000000000001
    filesystem_root: /path/to/local-data
    collection_root: /
  eagle:
    collection_id: 00000000-0000-0000-0000-000000000002
    filesystem_root: /path/to/remote-data
    collection_root: /

targets:
  crux:
    enabled: false
    compute_endpoint: 00000000-0000-0000-0000-000000000003
    workspace: /path/to/remote-data/workspace
    analysis_python: /path/to/compute/envs/analysis/bin/python
    code_directory: /path/to/compute/src/backend/src  # PYTHONPATH of the PBS job: the portal checkout's backend/src
    module_commands: []
    pbs: {account: PROJECT_ACCOUNT, queue: BATCH_QUEUE, nodes: 4, walltime: '01:00:00'}
    execution:
      workers: 32
      max_in_flight: 256
      reconstruction_workers: 32
      threads_per_worker: 4
      indexing_ranks_per_node: 4
      indexing_threads_per_worker: 1
      memory_limit_mb: 8192
    # The launcher's monitor stage lists the run's results/ on Eagle (one Transfer listing, with
    # the Transfer consent the crux cancel uses) only while the Flow is in RunPbsJob, at most every interval_seconds,
    # waiting at most timeout_seconds; the run reads stale when its newest status file is older than
    # stale_after_seconds. Only the launcher's copy needs it; these are the defaults. Keep interval_seconds well
    # under 90 s (the portal shows an observation older than 90 s as delayed) and timeout_seconds under it.
    listing: {interval_seconds: 30, timeout_seconds: 8, stale_after_seconds: 90}
    # While the monitor stage's Flow status call fails, the stage prints the last observation, stale,
    # and calls again 10 s later, then twice as long after each failure up to 60 s; the first call that fails once
    # the calls have failed for longer than this fails the stage, so DM ends the run. Only the launcher's copy needs
    # it; this is the default.
    status_failure_budget_seconds: 600
  aps:
    enabled: false
    submit_host: user@scheduler.example.invalid
    analysis_python: /path/to/local-compute/envs/analysis/bin/python
    code_directory: /path/to/local-compute/src/backend/src
    module_commands: []
    pbs: {account: null, queue: BATCH_QUEUE, nodes: 1, cpus: 32, walltime: '01:00:00'}
    execution: {workers: 32, max_in_flight: 256, reconstruction_workers: 4, threads_per_worker: 4}
