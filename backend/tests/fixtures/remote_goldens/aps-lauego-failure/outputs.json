   "value": "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n\n<geoN xmlns=\"http:example.com/geoN\">\n\t<dateWritten>Maon, Jan 1, 2020</dateWritten>\n\t<timeWritten>12:00:00 (-5)</timeWritten>\n\t<EPOCH start=\"midnight Jan 1, 1904\" unit=\"sec\">0</EPOCH>\n\n\t<Sample>\n\t\t<Origin unit=\"micron\">0 0 0</Origin>\t<!-- sample origin in raw positioner units (micron) -->\n\t\t<R unit=\"radian\">-0.006 0.006 -1.8e-05</R>\n\t</Sample>\n\n\t<Detectors Ndetectors=\"3\">\t\t\t<!-- Ndetectors, number of detectors in use, must be <= MAX_Ndetectors -->\n\t\t<Detector N=\"0\">\n\t\t\t<Npixels>2048 2048</Npixels>\t\t<!-- Nx,Ny is number of un-binned pixels in full detector -->\n\t\t\t<size unit=\"mm\">409.6 409.6</size>\t<!-- sizeX,sizeY otuside size of full detector -->\n\t\t\t<R unit=\"radian\">-1.20127231 -1.21381742 -1.21879073</R>\t\t<!-- Rotation and translation vector -->\n\t\t\t<P unit=\"mm\">28.720 3.010 513.097</P>\n\t\t\t<timeMeasured>Tue, Mar 29, 2022, 14:15:05 (-5)</timeMeasured>\t<!-- when this geometry was calculated -->\n\t\t\t<note>Optimized using CalibrationListOrange0</note>\n\t\t\t<ID>PE1621 723-3335</ID>\t\t\t\t<!-- unique detector ID -->\n\t\t</Detector>\n\t\t<Detector N=\"1\">\n\t\t\t<Npixels>1024 1024</Npixels>\n\t\t\t<size unit=\"mm\">204.8 204.8</size>\n\t\t\t<R unit=\"radian\">-1.74964147 -0.72538764 -1.7707796</R>\n\t\t\t<P unit=\"mm\">-144.183 26.808 402.341</P>\n\t\t\t<timeMeasured>Tue, Feb 26, 2019, 12:29:06 (-6)</timeMeasured>\n\t\t\t<note>Optimized using CalibrationListYellow1</note>\n\t\t\t<ID>PE0822 883-4841</ID>\n\t\t</Detector>\n\t\t<Detector N=\"2\">\n\t\t\t<Npixels>1024 1024</Npixels>\n\t\t\t<size unit=\"mm\">204.8 204.8</size>\n\t\t\t<R unit=\"radian\">-0.60682911 -1.49103705 -0.61968032</R>\n\t\t\t<P unit=\"mm\">-143.358 31.515 399.770</P>\n\t\t\t<timeMeasured>Tue, Oct 29, 2019, 14:10:51 (-5)</timeMeasured>\n\t\t\t<note>Optimized using CalibrationListPurple2</note>\n\t\t\t<ID>PE0822 883-4843</ID>\n\t\t</Detector>\n\t</Detectors>\n\n\t<Wire